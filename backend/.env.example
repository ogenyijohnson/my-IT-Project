# Copy this file to backend/.env and fill in values from your Supabase project.
# Never commit backend/.env or expose SUPABASE_SECRET_KEY to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional if you host the frontend on a different origin; omit for same-origin hosting.
CLIENT_URL=
PORT=5000
